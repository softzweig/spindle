{
  "name": "@softzweig/sample",
  "version": "0.0.0",
  "private": true,
  "description": "Minimal sample package, the starting point for a new @softzweig library.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/softzweig/softzweig-library-template.git",
    "directory": "packages/sample"
  },
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "dev": "tsc --project tsconfig.build.json --watch",
    "typecheck": "tsc --project tsconfig.json"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "public"
  },
  "devDependencies": {
    "@softzweig/typescript-config": "workspace:*",
    "typescript": "catalog:"
  }
}
